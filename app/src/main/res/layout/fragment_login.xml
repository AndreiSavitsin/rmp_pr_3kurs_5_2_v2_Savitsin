<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LoginFragment">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/welcome"
        android:layout_marginTop="100sp"
        android:layout_marginLeft="120sp"
        android:textSize="18sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/InputLogin"
        android:layout_marginLeft="100sp"
        android:layout_marginTop="170sp"/>

    <EditText
        android:id="@+id/loginInput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="@string/InputLogin"
        android:textSize="14sp"
        android:layout_marginLeft="100sp"
        android:layout_marginTop="190sp"
        android:width="200sp"
        android:textAlignment="center"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/InputPass"
        android:layout_marginLeft="100sp"
        android:layout_marginTop="240sp"/>

    <EditText
        android:id="@+id/passInput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="@string/InputPass"
        android:textSize="14sp"
        android:layout_marginLeft="100sp"
        android:layout_marginTop="260sp"
        android:width="200sp"
        android:textAlignment="center"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnLog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Login"
        android:textAllCaps="false"
        android:layout_marginTop="325sp"
        android:layout_marginLeft="150sp" />

</FrameLayout>